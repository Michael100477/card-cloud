# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (Prisma managed Postgres — run `npm run dev` to start)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=YOUR_LOCAL_KEY"

# Absolute path to the project root — needed when PM2 starts from a different
# working directory (process.cwd() may be wrong in that context)
PROJECT_ROOT="C:\\Users\\yourname\\card-cloud"

# Hosted Postgres (use this format when deploying)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── App URL ───────────────────────────────────────────────────────────────────
# The full URL of your app (no trailing slash) — used by NextAuth, OAuth
# callbacks, and outbound email links.
NEXTAUTH_URL="http://localhost:3001"

# Public-facing base URL — used inside emails and QR codes that the browser /
# scanner will load. Local dev uses the same as NEXTAUTH_URL. In production
# set both to https://thecardcloud.com (or your Railway URL during staging).
NEXT_PUBLIC_BASE_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"

# Generate a secret: run `openssl rand -base64 32` in your terminal
NEXTAUTH_SECRET="your-secret-here"

# ── Admin ─────────────────────────────────────────────────────────────────────
# Email address that gets the "Admin" tab + dispute notifications.
ADMIN_EMAIL="you@yourdomain.com"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Setup (5 min, free):
#   1. Go to console.cloud.google.com → New project → "The Card Cloud"
#   2. APIs & Services → OAuth consent screen → External → fill in app name & email
#   3. Credentials → Create → OAuth client ID → Web application
#   4. Authorized redirect URIs → add: http://localhost:3001/api/auth/callback/google
#      (add your production URL too when deploying)
#   5. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Apple Sign-In ─────────────────────────────────────────────────────────────
# Requires Apple Developer Program membership ($99/yr).
# Required for iOS App Store distribution. Optional for web-only.
# Setup:
#   1. developer.apple.com → Certificates, Identifiers & Profiles
#   2. Identifiers → Register App ID → enable "Sign In with Apple"
#   3. Identifiers → Register Services ID (this becomes APPLE_ID, e.g. com.thecardcloud.web)
#   4. Configure the Services ID → add redirect: https://yourdomain.com/api/auth/callback/apple
#   5. Keys → Create key → enable "Sign In with Apple" → download .p8 file
#   6. Run: node scripts/generate-apple-secret.js TEAM_ID KEY_ID SERVICE_ID path/to/key.p8
#      to generate the APPLE_SECRET JWT (valid 6 months, re-run when expired)
APPLE_ID=""
APPLE_SECRET=""
# Set to "true" once both APPLE_ID and APPLE_SECRET are filled in
NEXT_PUBLIC_APPLE_ENABLED="false"

# ── Anthropic Claude (for vision-based Scan Slab) ─────────────────────────────
# Powers the "Scan Slab" photo feature — reads labels directly like a human.
# Falls back to Tesseract OCR if not set. Get key at console.anthropic.com
ANTHROPIC_API_KEY=""

# ── Cloudflare R2 (production photo storage) ──────────────────────────────────
# Configured via the admin dashboard, not env vars.
# Admin → Platform → Credentials → Storage:
#   r2_account_id, r2_access_key, r2_secret_key, r2_bucket, r2_public_url
# If unset, uploads fall back to ./public/uploads/ on the local filesystem
# (fine for local dev, NOT for production — Railway's container filesystem is
# ephemeral and wipes on every redeploy).

# ── eBay ──────────────────────────────────────────────────────────────────────
# Production app credentials (developer.ebay.com → My Account → Application
# keysets → Production). Used by scripts/collect-*.ts training data scrapers.
EBAY_PROD_APP_ID=""
EBAY_PROD_CERT_ID=""

# Marketplace account deletion endpoint (required by eBay before they let your
# app go live — they POST a verification challenge here on subscribe).
# The verification token is any string you make up; the endpoint URL is your
# public URL + /api/ebay/marketplace-deletion.
EBAY_DELETION_VERIFICATION_TOKEN=""
EBAY_DELETION_ENDPOINT_URL=""

# ── Grader APIs (for Scan Slab cert lookup) ───────────────────────────────────
# PSA — free tier: 100 lookups/day. Register at psacard.com/api
# Without these set, Scan Slab still extracts the cert number but won't
# fetch card details automatically.
# Option A: pre-issued bearer token (simplest — get from psacard.com/api)
PSA_ACCESS_TOKEN=""
# Option B: OAuth client credentials (if you have a client ID + secret instead)
PSA_CLIENT_ID=""
PSA_CLIENT_SECRET=""
# SGC, CGC — add credentials here when available
# SGC_API_KEY=""
# CGC_API_KEY=""

# ── Email ─────────────────────────────────────────────────────────────────────
# Controls which provider sends email.
# Options: "resend" | "smtp" | "console"
# If not set, auto-detects from whichever credentials are present below.
# EMAIL_PROVIDER="smtp"

# The "from" address used by all providers
EMAIL_FROM="The Card Cloud <noreply@thecardcloud.com>"

# Sender address for support@ replies generated by the email agent
SUPPORT_FROM="support@thecardcloud.com"

# --- SMTP (Office 365, Gmail, any mail server) — preferred ---
# Office 365:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
# Gmail:       SMTP_HOST=smtp.gmail.com       SMTP_PORT=587  SMTP_SECURE=false
#              (Gmail requires an App Password, not your regular password)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""

# --- Resend (fallback) ---
# Get your key at resend.com → API Keys
# RESEND_API_KEY="re_your_key_here"
# RESEND_FROM="The Card Cloud <onboarding@resend.dev>"

# Inbound email webhook (Postmark / SendGrid / Mailgun parser → /api/email/inbound)
# Any random string — set the same value on your inbound parser's signing secret.
EMAIL_WEBHOOK_SECRET=""

# ── QR receive tokens ─────────────────────────────────────────────────────────
# Signs the QR codes printed on consignment packing slips + trade packing
# slips. Any random ≥32-char string. If unset, falls back to NEXTAUTH_SECRET.
RECEIVE_TOKEN_SECRET=""

# ── AI Lab (local sidecar service) ────────────────────────────────────────────
# URL of the local AI lab process (pm2: card-cloud-ai on port 3002).
# Leave unset in production — the AI lab is dev-only for now.
AI_LAB_URL="http://localhost:3002"

# Local Ollama for offline LLM testing in the AI lab
OLLAMA_URL="http://localhost:11434"

# Path to the Python binary used by lib/ocr.ts (Tesseract fallback)
PYTHON_PATH="python"
