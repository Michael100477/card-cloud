# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (Prisma managed Postgres — run `npm run dev` to start)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=YOUR_LOCAL_KEY"
# Hosted Postgres (use this format when deploying)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret: run `openssl rand -base64 32` in your terminal
NEXTAUTH_SECRET="your-secret-here"
# The full URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3001"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3001/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Email ─────────────────────────────────────────────────────────────────────
# Controls which provider sends email.
# Options: "resend" | "smtp" | "console"
# If not set, auto-detects from whichever credentials are present below.
# EMAIL_PROVIDER="resend"

# The "from" address used by all providers
EMAIL_FROM="The Card Cloud <onboarding@resend.dev>"

# --- Resend (default, free tier: 3,000/mo) ---
# Get your key at resend.com → API Keys
# Free to start; no domain verification needed while testing
RESEND_API_KEY="re_your_key_here"

# --- SMTP (Office 365, Gmail, any mail server) ---
# Uncomment and fill in to switch to SMTP; set EMAIL_PROVIDER=smtp
# Office 365:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
# Gmail:       SMTP_HOST=smtp.gmail.com       SMTP_PORT=587  SMTP_SECURE=false
#              (Gmail requires an App Password, not your regular password)
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@yourdomain.com"
# SMTP_PASS="your-password-or-app-password"
