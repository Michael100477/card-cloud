# Copy to .env and fill in:
#   cp scripts/agent-runner/.env.example scripts/agent-runner/.env
# Then edit values.

# Card Cloud URL the runner polls. Production:
CARD_CLOUD_URL=https://card-cloud-production.up.railway.app

# Shared secret matching site_credentials.agent_runner_token on the server.
# Generate one (any random string) and paste into both places.
AGENT_RUNNER_TOKEN=

# Optional — defaults are usually fine.
POLL_INTERVAL_MS=60000
# PROJECT_ROOT=C:\Users\mikea\card-cloud
