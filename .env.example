# Copy this file to .env and fill in your values.
# Never commit .env — it is gitignored.

# ── Database ──────────────────────────────────────────────────────────────────
# Local development (Prisma managed Postgres — run `npm run dev` to start)
DATABASE_URL="prisma+postgres://localhost:51213/?api_key=YOUR_LOCAL_KEY"

# Absolute path to the project root — needed when PM2 starts from a different
# working directory (process.cwd() may be wrong in that context)
PROJECT_ROOT="C:\\Users\\yourname\\card-cloud"
# Hosted Postgres (use this format when deploying)
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# ── NextAuth ──────────────────────────────────────────────────────────────────
# Generate a secret: run `openssl rand -base64 32` in your terminal
NEXTAUTH_SECRET="your-secret-here"
# The full URL of your app (no trailing slash)
NEXTAUTH_URL="http://localhost:3001"

# ── Google OAuth ──────────────────────────────────────────────────────────────
# Setup (5 min, free):
#   1. Go to console.cloud.google.com → New project → "The Card Cloud"
#   2. APIs & Services → OAuth consent screen → External → fill in app name & email
#   3. Credentials → Create → OAuth client ID → Web application
#   4. Authorized redirect URIs → add: http://localhost:3001/api/auth/callback/google
#      (add your production URL too when deploying)
#   5. Copy the Client ID and Client Secret below
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ── Apple Sign-In ─────────────────────────────────────────────────────────────
# Requires Apple Developer Program membership ($99/yr).
# Required for iOS App Store distribution. Optional for web-only.
# Setup:
#   1. developer.apple.com → Certificates, Identifiers & Profiles
#   2. Identifiers → Register App ID → enable "Sign In with Apple"
#   3. Identifiers → Register Services ID (this becomes APPLE_ID, e.g. com.thecardcloud.web)
#   4. Configure the Services ID → add redirect: https://yourdomain.com/api/auth/callback/apple
#   5. Keys → Create key → enable "Sign In with Apple" → download .p8 file
#   6. Run: node scripts/generate-apple-secret.js TEAM_ID KEY_ID SERVICE_ID path/to/key.p8
#      to generate the APPLE_SECRET JWT (valid 6 months, re-run when expired)
APPLE_ID=""
APPLE_SECRET=""
# Set to "true" once both APPLE_ID and APPLE_SECRET are filled in
NEXT_PUBLIC_APPLE_ENABLED="false"

# ── Grader APIs (for Scan Slab cert lookup) ───────────────────────────────────
# PSA — free tier: 100 lookups/day. Register at psacard.com/api
# Without these set, Scan Slab still extracts the cert number but won't
# fetch card details automatically.
# Option A: pre-issued bearer token (simplest — get from psacard.com/api)
PSA_ACCESS_TOKEN=""
# Option B: OAuth client credentials (if you have a client ID + secret instead)
PSA_CLIENT_ID=""
PSA_CLIENT_SECRET=""
# SGC, CGC — add credentials here when available
# SGC_API_KEY=""
# CGC_API_KEY=""

# ── Email ─────────────────────────────────────────────────────────────────────
# Controls which provider sends email.
# Options: "resend" | "smtp" | "console"
# If not set, auto-detects from whichever credentials are present below.
# EMAIL_PROVIDER="resend"

# The "from" address used by all providers
EMAIL_FROM="The Card Cloud <onboarding@resend.dev>"

# --- Resend (default, free tier: 3,000/mo) ---
# Get your key at resend.com → API Keys
# Free to start; no domain verification needed while testing
RESEND_API_KEY="re_your_key_here"

# --- SMTP (Office 365, Gmail, any mail server) ---
# Uncomment and fill in to switch to SMTP; set EMAIL_PROVIDER=smtp
# Office 365:  SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURE=false
# Gmail:       SMTP_HOST=smtp.gmail.com       SMTP_PORT=587  SMTP_SECURE=false
#              (Gmail requires an App Password, not your regular password)
# SMTP_HOST="smtp.office365.com"
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER="you@yourdomain.com"
# SMTP_PASS="your-password-or-app-password"
