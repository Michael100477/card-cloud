generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────
// Enums
// ─────────────────────────────────────────

enum PlanTier {
  FREE
  TRIAL
  MONTHLY
  ANNUAL
}

enum CardStatus {
  TRACKING
  OFFER_PENDING
  OFFER_ACCEPTED
  CONSIGNED
  LISTED
  SOLD
  TRADE_LISTED
  IN_TRADE
}

// ─────────────────────────────────────────
// Auth models (required by NextAuth + Prisma adapter)
// ─────────────────────────────────────────

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  token     String   @unique @default(cuid())
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

// ─────────────────────────────────────────
// Core models
// ─────────────────────────────────────────

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  emailVerified    DateTime?
  username         String?   @unique
  displayName      String?
  passwordHash     String?

  planTier         PlanTier  @default(FREE)
  trialEndsAt      DateTime?

  stripeCustomerId String?   @unique
  stripeConnectId  String?   @unique

  profilePhoto     String?
  bio              String?
  location         String?
  isPublic         Boolean   @default(false)

  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  accounts         Account[]
  sessions         Session[]
  cards            Card[]
  collections      Collection[]
  passwordResets   PasswordResetToken[]

  @@map("users")
}

model Collection {
  id          String   @id @default(cuid())
  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  name        String
  description String?
  slug        String?
  coverImage  String?
  isPublic    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cards       CardCollection[]
  snapshots   CollectionSnapshot[]

  @@index([ownerId])
  @@unique([ownerId, slug])
  @@map("collections")
}

model CollectionSnapshot {
  id           String     @id @default(cuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  totalValue   Decimal    @db.Decimal(10, 2)
  cardCount    Int

  capturedAt   DateTime   @default(now())

  @@index([collectionId, capturedAt])
  @@map("collection_snapshots")
}

model CardCollection {
  cardId       String
  collectionId String
  addedAt      DateTime @default(now())

  card         Card       @relation(fields: [cardId], references: [id], onDelete: Cascade)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  @@id([cardId, collectionId])
  @@map("card_collections")
}

model Card {
  id             String     @id @default(cuid())
  ownerId        String
  owner          User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // Identity
  player         String
  year           Int
  manufacturer   String
  set            String
  subset         String?
  cardNumber     String?
  serialNumber   String?   // print run e.g. "5/10", "/25", "1/1"
  sport          String?
  team           String?
  notes          String?   // general notes (separate from condition notes)

  // Grading
  grade          String?
  gradeCompany   String?
  certNumber     String?

  // Tags (Rookie, Auto, Jersey, Numbered, etc.)
  tags           String[]

  // Condition & photos
  conditionNotes String?
  photos         String[]

  // Live value (populated by eBay background job — Phase 2)
  estimatedValue  Decimal?  @db.Decimal(10, 2)
  lastValueUpdate DateTime?

  // Acquisition
  acquiredDate   DateTime?
  acquiredPrice  Decimal?  @db.Decimal(10, 2)
  acquiredSource String?

  // BGS subgrades — only populated for BGS / BGGS graded cards
  bgsSubCentering Decimal? @db.Decimal(4, 1)
  bgsSubCorners   Decimal? @db.Decimal(4, 1)
  bgsSubEdges     Decimal? @db.Decimal(4, 1)
  bgsSubSurface   Decimal? @db.Decimal(4, 1)

  isFeatured     Boolean    @default(false)  // admin-curated showcase on landing page
  status         CardStatus @default(TRACKING)
  isPublic       Boolean    @default(false)

  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  collections    CardCollection[]

  @@index([ownerId])
  @@map("cards")
}
